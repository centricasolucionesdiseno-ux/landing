# Endurecimiento del backend (Apache, antes de que la petición llegue a PHP):
# lo que no es necesario se rechaza aquí, lo más barato posible.

# Ninguna petición legítima pesa más de 8 KB (el PHP vuelve a comprobarlo)
LimitRequestBody 16384

# Solo GET y POST
<LimitExcept GET POST>
  Require all denied
</LimitExcept>

# Solo se sirven los puntos de entrada y la hoja de estilos de las páginas
<FilesMatch ".">
  Require all denied
</FilesMatch>
<FilesMatch "^(solicitar|confirmar|gestionar|mensaje)\.php$|^estilo\.css$">
  Require all granted
</FilesMatch>

Options -Indexes
