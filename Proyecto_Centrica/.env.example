# URL de la aplicación web de Google Apps Script que agenda las citas
# (instrucciones al inicio de integraciones/agenda-google/Codigo.gs). Copia este archivo como .env
VITE_AGENDA_ENDPOINT=

# Cloudflare Turnstile (anti-bots del formulario). Clave PÚBLICA del sitio.
# La clave secreta va solo en Propiedades del script de Google (TURNSTILE_SECRET).
VITE_TURNSTILE_SITEKEY=
