# Opcional: URL del backend de citas. Por defecto /api/agenda/solicitar.php (PHP en
# el mismo hosting, ver integraciones/agenda-hostinger/README.md)
VITE_AGENDA_ENDPOINT=

# Cloudflare Turnstile (anti-bots del formulario). Clave PÚBLICA del sitio.
# La clave secreta va solo en config.php del servidor ('turnstile_secreto').
VITE_TURNSTILE_SITEKEY=
