{
  "name": "proyecto-centrica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:red": "vite --host",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir node_modules/.cache/prerender --emptyOutDir && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:red": "npm run build && vite preview --host",
    "compartir": "node scripts/compartir.mjs",
    "seguridad": "npm audit --audit-level=moderate && eslint ."
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "vite": "^8.3.2"
  }
}
